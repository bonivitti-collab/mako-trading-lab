# Mako Trading Lab - Production Environment Variables
# Copy to .env.local for local development

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://njdbgtnffnuvrosokguy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (AI Studio + Mindset Mentor)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Hotmart (Pro Pass $19/mo — works for international buyers)
# Payment link from Hotmart product (Assinatura / Subscription)
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/YOUR_PRODUCT_CODE
# Webhook hottok (Tools → Webhook) — header X-HOTMART-HOTTOK
# Endpoint: https://makotradinglab.com/api/webhooks/hotmart
HOTMART_HOTTOK=your-hotmart-hottok-token
